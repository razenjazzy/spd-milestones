# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
# For Docker: use mongodb://mongo:27017/spd
# For local development: use mongodb://localhost:27017/spd
# For production: use your MongoDB Atlas URI or external MongoDB
MONGO_URI=mongodb://localhost:27017/spd
# MONGO_URI=mongodb://mongo:27017/spd

# CORS Configuration
# For Docker frontend: http://localhost:3000
# For Vite dev server: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://spd.milestones

# Logging Configuration
# Enable file-based logging (true/false)
LOG_TO_FILE=true

# Number of days to retain log files (1-365)
LOG_RETENTION_DAYS=30

# Minimum log level: debug, info, warn, error
# debug: verbose (development)
# info: standard (production)
# warn: warnings and errors only
# error: errors only
LOG_LEVEL=debug

# Monitoring Configuration
# Interval in minutes for automatic project health checks (1-1440)
# Recommended: 15 (development), 60 (production)
MONITORING_INTERVAL_MINUTES=60

# GraphQL Configuration
# GraphQL endpoint path
GRAPHQL_PATH=/graphql

# Enable GraphQL Playground (true/false) - auto-disabled in production
GRAPHQL_PLAYGROUND=true

# Enable GraphQL introspection (true/false) - auto-disabled in production
GRAPHQL_INTROSPECTION=true

# API Configuration
# API prefix for REST endpoints
API_PREFIX=/api

# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=30000

# Maximum request body size
MAX_REQUEST_SIZE=10mb

# AI Configuration (Gemini)
# Get an API key from Google AI Studio and set it here
GEMINI_API_KEY=
# Default model used by AI CLI when provider=gemini
GEMINI_MODEL=gemini-2.0-flash-lite
# Gemini API base URL (change only for proxies/gateways)
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# Automatically fallback to local parser if Gemini fails (recommended)
GEMINI_FALLBACK_TO_LOCAL=true
# Optional explicit command for Gemini CLI bridge (example: npx --yes @google/gemini-cli)
GEMINI_CLI_COMMAND=
# Path Gemini CLI should use as current working directory (set to your full repo path)
GEMINI_CLI_CODEBASE_PATH=
# Timeout for Gemini CLI execution in milliseconds
GEMINI_CLI_TIMEOUT_MS=45000

# Security Configuration
# Enable CORS (true/false)
CORS_ENABLED=true

# Rate limiting window in milliseconds (15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Admin Security
# Required to bootstrap/register admin users
ADMIN_REGISTRATION_KEY=replace-with-strong-admin-registration-key

# Required to revalidate and reveal masked release download links
ADMIN_LINK_REVALIDATION_PASSWORD=replace-with-strong-link-revalidation-password
