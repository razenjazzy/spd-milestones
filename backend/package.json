{
    "name": "spd-milestones-backend",
    "version": "1.0.0-beta.1",
    "description": "Backend for SPD Milestones (Express + TypeScript + MongoDB)",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "lint": "eslint . --ext .ts"
    },
    "author": "spd",
    "license": "MIT",
    "dependencies": {
        "@apollo/client": "^4.0.9",
        "@apollo/server": "^5.1.0",
        "bcryptjs": "^2.4.3",
        "body-parser": "^1.20.3",
        "cors": "^2.8.5",
        "date-fns": "^2.30.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "graphql": "^16.12.0",
        "graphql-tag": "^2.12.6",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^7.3.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/body-parser": "^1.19.2",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^20.5.6",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.5.6"
    }
