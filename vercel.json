{
  "version": 2,
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "routes": [
    { "src": "/api/(.*)", "dest": "https://spd-backend-nyzi.onrender.com/api/$1" },
    { "src": "/graphql", "dest": "https://spd-backend-nyzi.onrender.com/graphql" },
    { "src": "/graphql/(.*)", "dest": "https://spd-backend-nyzi.onrender.com/graphql/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
